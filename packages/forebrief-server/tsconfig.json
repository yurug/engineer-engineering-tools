{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // @brief/primitives (card-visual round, seq 36/37) is subpath-
    // exports only ("./diagram", "./filmstrip") -- the base config's
    // Node10 resolution (kb/architecture/overview.md: chosen for
    // @brief/core/shared, which have none) cannot see a package.json
    // "exports" map at all. Bundler resolution is a type-checking-only
    // setting (Node's OWN runtime resolution -- verified: a real `require`
    // of the subpath already works, see rounds/mint-and-validate.ts) --
    // "module" stays CommonJS, so nothing about this package's emitted
    // output or its existing relative-import style changes.
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": ["src"]
}

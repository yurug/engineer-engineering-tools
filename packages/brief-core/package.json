{
  "name": "@brief/core",
  "version": "0.2.0",
  "private": true,
  "description": "Shared server/CLI infrastructure (auth, event store, discovery, citation validation, daemon mechanism) extracted from @backbrief/server for reuse by any brief-style tool (ADR-001).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brief/shared": "*",
    "@hono/node-server": "^2.0.8",
    "hono": "^4.12.29",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}

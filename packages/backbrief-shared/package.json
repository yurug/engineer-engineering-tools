{
  "name": "@backbrief/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Envelope/Citation/action/event types, zod schemas, content normalization, and the AppError/Result vocabulary shared by every backbrief package.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/index.browser.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ulid": "^3.0.2",
    "zod": "^4.4.3",
    "@brief/shared": "*"
  }
}

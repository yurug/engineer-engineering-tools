{
  "name": "engineer-engineering-tools",
  "private": true,
  "version": "0.1.0",
  "description": "backbrief, forebrief and inbrief — the tools an engineer uses to steer agentic development — and the library they share.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
